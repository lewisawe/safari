# Safari environment (design section 8.3)
# Copy to .env.local and fill in. Live Sanity vars are required for `npm run seed`
# and the live agent/traverse paths. The model key is OPTIONAL — the model-free
# /solver path runs the full pipeline with no key.

# --- Sanity (required for seed + live reads/writes) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Model provider (OPTIONAL) ---
# Only needed for the LLM agent path (/agent). The deterministic model-free
# path (/solver) works without it.
#
# Option A: Amazon Bedrock (Amazon Nova Pro). No API key; uses the AWS SDK
# credential chain (AWS_PROFILE locally, env keys or an IAM role when deployed).
# Bedrock is pay-per-token, not free.
# MODEL_PROVIDER=bedrock
# MODEL_NAME=us.amazon.nova-pro-v1:0
# AWS_REGION=us-east-1
# Locally: a named profile.
# AWS_PROFILE=your-aws-profile
# Deployed (Vercel): an IAM user limited to bedrock:InvokeModel* on Nova Pro.
# Do NOT set AWS_PROFILE there, or the env keys are ignored.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
#
# Option B: a key-based provider, openai (default) or anthropic.
MODEL_PROVIDER_API_KEY=
MODEL_PROVIDER=openai
# Optional model id override (defaults: bedrock=us.amazon.nova-pro-v1:0,
# openai=gpt-4o, anthropic=claude-sonnet-4-20250514).
MODEL_NAME=

# --- Sanity Context MCP (OPTIONAL) ---
# When these are absent everything falls back to the local @sanity/client
# (the UI shows "via: sanity-client (Context not configured)").
# Full MCP endpoint URL copied from Dashboard -> Context -> MCP endpoint
# (treated as opaque; the app adds mode=groq / mode=knowledge_base itself).
SANITY_CONTEXT_MCP_URL=
# ORGANIZATION token with the Context Viewer role. Project tokens are rejected
# with 403 contextGrantRequired.
SANITY_CONTEXT_TOKEN=
# Knowledge Base id (starts with `kb`). Enables Knowledge Base mode
# (initial_context + knowledge_base_read) for cited evidence.
SANITY_KB_ID=

# --- Agent cost guard (OPTIONAL; public demo) ---
# Global agent runs per UTC day, counted in Sanity (needs SANITY_API_WRITE_TOKEN;
# without a working counter the agent fails closed). Default 50.
AGENT_DAILY_CAP=
# Agent questions per visitor IP per hour (per server instance). Default 5.
AGENT_RATE_PER_HOUR=
# Set to false to switch the agent off (the page shows the disabled card).
AGENT_ENABLED=
