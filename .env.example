# Safari environment (design section 8.3)
# Copy to .env.local and fill in. Live Sanity vars are required for `npm run seed`
# and the live agent/traverse paths. The model key is OPTIONAL — the model-free
# /solver path runs the full pipeline with no key.

# --- Sanity (required for seed + live reads/writes) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Model provider (OPTIONAL) ---
# Only needed for the LLM agent path (/agent). The deterministic model-free
# path (/solver) works without it.
MODEL_PROVIDER_API_KEY=
# Which provider the key is for: openai (default) or anthropic.
MODEL_PROVIDER=openai
# Optional model id override (defaults: openai=gpt-4o, anthropic=claude-sonnet-4-20250514).
MODEL_NAME=
