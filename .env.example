# Safari environment (design section 8.3)
# Copy to .env.local and fill in. Live Sanity vars are required for `npm run seed`
# and the live agent/traverse paths. The model key is OPTIONAL — the model-free
# /solver path runs the full pipeline with no key.

# --- Sanity (required for seed + live reads/writes) ---
SANITY_PROJECT_ID=
SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# --- Model provider (OPTIONAL) ---
# Only needed for the LLM agent path (/agent). The deterministic model-free
# path (/solver) works without it.
MODEL_PROVIDER_API_KEY=
# Which provider the key is for: openai (default) or anthropic.
MODEL_PROVIDER=openai
# Optional model id override (defaults: openai=gpt-4o, anthropic=claude-sonnet-4-20250514).
MODEL_NAME=

# --- Sanity Context MCP (OPTIONAL) ---
# When these are absent everything falls back to the local @sanity/client
# (the UI shows "via: sanity-client (Context not configured)").
# Full MCP endpoint URL copied from Dashboard -> Context -> MCP endpoint
# (treated as opaque; the app adds mode=groq / mode=knowledge_base itself).
SANITY_CONTEXT_MCP_URL=
# ORGANIZATION token with the Context Viewer role. Project tokens are rejected
# with 403 contextGrantRequired.
SANITY_CONTEXT_TOKEN=
# Knowledge Base id (starts with `kb`). Enables Knowledge Base mode
# (initial_context + knowledge_base_read) for cited evidence.
SANITY_KB_ID=
